PORT=3001
NODE_ENV=development
# Supabase Dashboard > Connect > Session pooler connection string (port 5432).
# Keep this private; URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGINS=http://localhost:3001
PUBLIC_API_URL=http://localhost:3001
TURN_SERVERS_JSON=[]
